    "eval:classificar": "tsx scripts/eval-classificar.ts",
    "test": "jest",
    "lint": "biome lint src test",
    "format": "biome format --write src test",
    "check": "tsc --noEmit && biome lint src test && pnpm test",
    "buildR": "prisma generate && tsc",
    "devR": "tsx src/main/server.ts",
    "test:unit": "NODE_OPTIONS=--experimental-vm-modules jest --testMatch='**/*.{unit,integration}.spec.ts'"
  },
