generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Canal {
  WHATSAPP
  WEB
  TELEGRAM
}

enum MotivoFinalizacao {
  CONCLUIDA
  HANDOFF
  RECUSADA
  ABANDONO
}

model Conversation {
  id        String @id @default(uuid())
  sessionId String
  canal     Canal
  idPessoa  String
  flowId    String

  dadosColetados Json @default("{}")

  iniciadoEm       DateTime  @default(now())
  ultimaMensagemEm DateTime?
  finalizadaEm     DateTime?

  motivoFinalizacao MotivoFinalizacao?

  ultimoFlowId String @default("")
  ultimoNodeId String @default("")

  tags String[] @default([])
  csat Float?

  @@index([idPessoa])
  @@index([sessionId])
  @@index([flowId])
  @@index([canal])
  @@index([iniciadoEm])
  @@index([finalizadaEm])
}
